  classDef commerce fill:#FFE9E2,stroke:#C84A2F,color:#111;
  classDef gov fill:#F0F0F0,stroke:#555,color:#111;
  class PO,INVOICE,PAY,SETTLE commerce;
  class DREQ,SHIP,DISPATCH,ROUTE,VEH,DRIVER,DEL,DELEVT,POD,GRN,INV,INST,ELEM,INSP,ACCEPT log;
  class EVID,DOC,EVENT,AUDIT,AI,ACTION,APPROVAL gov;
