{
  "ontology_id": "wajenzi-core",
  "version": "0.1.0",
  "status": "draft",
  "namespace": "https://id.wajenzi.ai/ontology/",
  "classes": [
    {"code": "organization", "label": "Organization"},
    {"code": "organization_role", "label": "Organization Role"},
    {"code": "person", "label": "Person"},
    {"code": "product", "label": "Product"},
    {"code": "product_listing", "label": "Product Listing"},
    {"code": "category", "label": "Category"},
    {"code": "product_type", "label": "Product Type"},
    {"code": "brand", "label": "Brand"},
    {"code": "material", "label": "Material"},
    {"code": "unit", "label": "Unit"},
    {"code": "attribute_definition", "label": "Attribute Definition"},
    {"code": "location", "label": "Location"},
    {"code": "application", "label": "Application"},
    {"code": "project", "label": "Project"},
    {"code": "project_phase", "label": "Project Phase"},
    {"code": "standard", "label": "Standard"},
    {"code": "document", "label": "Document"},
    {"code": "relationship_assertion", "label": "Relationship Assertion"}
  ],
  "predicates": [
    {"code": "has_parent", "domain": ["category", "product_type", "application", "project_phase"], "range": ["category", "product_type", "application", "project_phase"], "transitive": true},
    {"code": "classified_as", "domain": ["product", "product_listing", "product_type"], "range": ["category", "product_type"]},
    {"code": "has_product_type", "domain": ["product"], "range": ["product_type"]},
    {"code": "has_brand", "domain": ["product"], "range": ["brand"]},
    {"code": "manufactured_by", "domain": ["product"], "range": ["organization"]},
    {"code": "has_material", "domain": ["product"], "range": ["material"]},
    {"code": "has_attribute", "domain": ["product", "product_listing"], "range": ["attribute_definition"]},
    {"code": "offered_as", "domain": ["product_listing"], "range": ["product"]},
    {"code": "listed_by", "domain": ["product_listing"], "range": ["organization"]},
    {"code": "compatible_with", "domain": ["product", "product_type"], "range": ["product", "product_type"], "symmetric": true},
    {"code": "alternative_to", "domain": ["product", "product_type"], "range": ["product", "product_type"], "symmetric": true},
    {"code": "requires", "domain": ["product", "product_type", "project"], "range": ["product", "product_type", "material", "standard"]},
    {"code": "used_for", "domain": ["product", "material", "product_type"], "range": ["application", "project_phase"]},
    {"code": "applicable_standard", "domain": ["product", "product_type", "project"], "range": ["standard"]},
    {"code": "installed_with", "domain": ["product", "product_type"], "range": ["product", "product_type"]},
    {"code": "available_in", "domain": ["product_listing", "organization"], "range": ["location"]},
    {"code": "evidenced_by", "domain": ["*"], "range": ["document"]}
  ],
  "lifecycle_states": ["draft", "active", "deprecated", "blocked", "merged"],
  "identifier_types": [
    "canonical_entity_id",
    "public_registry_uri",
    "supplier_sku",
    "manufacturer_part_number",
    "business_registration_number",
    "tax_identifier",
    "external_record_id",
    "alias",
    "former_id"
  ],
  "identifier_rule": {
    "canonical_key": "uuid",
    "namespace_required_for_external_ids": true,
    "ids_are_reusable": false,
    "merged_ids_redirect": true,
    "public_uri_template": "https://id.wajenzi.ai/e/{entity_id}"
  }
}
