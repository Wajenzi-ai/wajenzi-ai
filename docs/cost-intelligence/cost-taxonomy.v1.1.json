  "financialViews": [
    {
      "code": "technical_construction_estimate",
      "includes": "Direct physical works only; net of separately identified input tax."
    },
    {
      "code": "forecast_delivery_cost",
      "includes": "Technical estimate + indirect + financing + expected residual risk + residual contingency + non-recoverable input taxes and other project taxes."
    },
    {
      "code": "customer_commercial_price",
      "includes": "Forecast delivery cost + chosen markup or gross margin + service fees + configured customer output tax."
    },
    {
      "code": "funding_requirement",
      "includes": "Peak cumulative cash deficit from timed inflows/outflows and opening cash."
    }
